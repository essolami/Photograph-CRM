generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  tasks     EditorTask[]
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  defenseDate DateTime? @db.Date
  defenseTime String?
  facultyId Int?
  packId Int?
  isDuo Boolean @default(false)
  facultyName String?
  packName String?
  basePrice Decimal @default(0) @db.Decimal(10, 2)
  supplements Json @default("[]")
  advance Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total Decimal @default(0) @db.Decimal(10, 2)
  photographerId Int?
  editorId Int?
  photographer Photographer? @relation(fields: [photographerId], references: [id], onDelete: SetNull)
  editor Editor? @relation(fields: [editorId], references: [id], onDelete: SetNull)
  status String @default("En cours")
  driveUrl String?
  comment String?
  grossProfit Decimal? @db.Decimal(10, 2)
  googleEventId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TogeSale {
  id           Int      @id @default(autoincrement())
  customerName String
  phone        String
  element      String
  color        String
  size         String
  location     String
  price        Decimal  @db.Decimal(10, 2)
  advance      Decimal  @default(0) @db.Decimal(10, 2)
  isDelivered  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerName])
  @@index([createdAt])
}

model Faculty {
  rates FacultyPackRate[]
  id        Int      @id @default(autoincrement())
  name      String   @unique
  soloPrice Decimal  @default(0) @db.Decimal(10, 2)
  duoPrice  Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pack {
  rates FacultyPackRate[]
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplement {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  price     Decimal  @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photographer {
  clients Client[]
  id        Int      @id @default(autoincrement())
  name      String   @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Editor {
  clients Client[]
  tasks   EditorTask[]
  users   User[]
  id        Int      @id @default(autoincrement())
  name      String   @unique
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EditorTask {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("Pas commencée")
  dueDate     DateTime? @db.Date
  editorId    Int
  editor      Editor   @relation(fields: [editorId], references: [id], onDelete: Cascade)
  clientId    Int?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([editorId, status])
  @@index([clientId])
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  role              String    @default("USER")
  passwordHash      String
  editorId          Int?
  editor            Editor?   @relation(fields: [editorId], references: [id], onDelete: SetNull)
  isActive          Boolean   @default(true)
  canViewClients    Boolean   @default(true)
  canManageClients  Boolean   @default(false)
  canViewInvoices   Boolean   @default(false)
  canManageInvoices Boolean   @default(false)
  canManageUsers    Boolean   @default(false)
  sessions          Session[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model GoogleCalendarConnection {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  refreshToken String
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FacultyPackRate {
  id Int @id @default(autoincrement())
  facultyId Int
  packId Int
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)
  soloPrice Decimal @db.Decimal(10, 2)
  duoPrice Decimal @db.Decimal(10, 2)
  @@unique([facultyId, packId])
}
